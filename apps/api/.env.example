SCOPUS_API_KEY=replace-with-your-elsevier-api-key
# Optional institution token for entitled content.
SCOPUS_INST_TOKEN=
PORT=3000
HOST=127.0.0.1
SCOPUS_BASE_URL=https://api.elsevier.com
SCOPUS_REQUEST_TIMEOUT_MS=30000
SCOPUS_MAX_RETRIES=2
SCOPUS_HYDRATION_CONCURRENCY=6
# Use * for local development, or a comma-separated allowlist in production.
CORS_ORIGIN=http://localhost:5173
